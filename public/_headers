# Vercel reads headers from vercel.json, not this file — this exists only
# as a fallback for Netlify/Cloudflare Pages if the site is ever migrated
# off Vercel. Keep it in sync with vercel.json's headers block.
#
# script-src needs 'unsafe-inline': Next.js App Router emits its own inline
# hydration-bootstrap scripts (self.__next_f.push(...) RSC payloads) whose
# content differs per page and per build — a hash-based allowlist would need
# regenerating on every single content change across every page, which isn't
# maintainable. This site has no user-input-to-HTML pathway (fully static,
# no CMS, no user-generated content rendered unescaped), so the realistic
# XSS surface 'unsafe-inline' gives up here is low. vercel.live is Vercel's
# own preview-deployment feedback widget, not app code.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://cdn.simpleicons.org; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline' https://vercel.live; connect-src 'self' https://vercel.live wss://vercel.live; frame-src https://www.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
